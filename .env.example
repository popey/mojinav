# OpenRouteService API Key — used by the Worker for routing.
# Local dev: drop this into worker/.dev.vars (already gitignored) so
# `wrangler dev` picks it up. Production: `wrangler secret put ORS_API_KEY`.
# Get your free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_api_key_here

# Optional: the public hostname Vite's dev server is reached at when
# deployed behind a reverse proxy (Cloudflare, nginx, etc.). Tells Vite
# to accept that Host header and route HMR over wss back through the
# proxy. Leave unset for local dev.
# VITE_PUBLIC_HOST=your-domain.example

# Optional: backend URL the Vite dev server proxies /api requests to
# during local development. Defaults to http://localhost:8787 (i.e.
# `wrangler dev` from worker/). In production Cloudflare intercepts
# /api/* before reaching Vite, so this is dev-only.
# VITE_API_URL=http://localhost:8787
