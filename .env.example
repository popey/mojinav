# OpenRouteService API Key
# Get your free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_api_key_here

# Optional: contact URL embedded in the User-Agent sent to Overpass / ORS.
# OSM operators may use this to reach you if your deployment misbehaves.
# If unset, defaults to the upstream project's GitHub URL.
# MOJINAV_CONTACT_URL=https://your-domain.example/

# Optional: the public hostname Vite's dev server is reached at when
# deployed behind a reverse proxy (Cloudflare, nginx, etc.). Tells Vite
# to accept that Host header and route HMR over wss back through the
# proxy. Leave unset for local dev.
# VITE_PUBLIC_HOST=your-domain.example

# Optional: backend URL the Vite dev server proxies /api requests to.
# Defaults to http://localhost:8000 (i.e. running the backend directly
# via uv on the host). docker-compose.yml overrides this to
# http://backend:8000 so the frontend container reaches the backend
# container over the docker network.
# VITE_API_URL=http://localhost:8000

# Optional: backend log level. Defaults to INFO. The verbose Overpass
# query body logged at DEBUG embeds raw user coordinates, so don't enable
# DEBUG in production unless you want those in the docker logs.
# MOJINAV_LOG_LEVEL=DEBUG
